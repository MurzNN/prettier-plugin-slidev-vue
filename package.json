{
  "name": "prettier-plugin-slidev-vue",
  "version": "0.2.4",
  "description": "Format Slidev Markdown and embedded Vue components, with Vue attribute and UnoCSS class sorting.",
  "license": "MIT",
  "author": "Alexey Korepov",
  "homepage": "https://github.com/MurzNN/prettier-plugin-slidev-vue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MurzNN/prettier-plugin-slidev-vue.git"
  },
  "bugs": {
    "url": "https://github.com/MurzNN/prettier-plugin-slidev-vue/issues"
  },
  "type": "module",
  "exports": "./index.js",
  "files": [
    "index.js",
    "uno.config.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.28.6",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "playground": "node playground/server.mjs",
    "release": "release-it"
  },
  "release-it": {
    "git": {
      "requireCleanWorkingDir": true,
      "commitMessage": "Release ${version}",
      "tagName": "v${version}"
    },
    "github": {
      "release": true,
      "releaseName": "Release ${version}"
    },
    "npm": {
      "publish": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "infile": "CHANGELOG.md",
        "header": "# Changelog\n\nEach version below is generated from Conventional Commits by release-it.\nThis project follows [Semantic Versioning](https://semver.org/spec/v2.0.0.html).",
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "feat",
              "section": "Added"
            },
            {
              "type": "fix",
              "section": "Fixed"
            },
            {
              "type": "perf",
              "section": "Changed"
            },
            {
              "type": "refactor",
              "section": "Changed"
            },
            {
              "type": "docs",
              "section": "Documentation",
              "effect": "changelog"
            },
            {
              "type": "chore",
              "section": "Chores",
              "effect": "hidden"
            },
            {
              "type": "test",
              "section": "Tests",
              "effect": "hidden"
            },
            {
              "type": "ci",
              "section": "CI",
              "effect": "hidden"
            },
            {
              "type": "style",
              "section": "Style",
              "effect": "hidden"
            }
          ]
        }
      }
    }
  },
  "keywords": [
    "prettier",
    "prettier-plugin",
    "slidev",
    "vue",
    "unocss"
  ],
  "peerDependencies": {
    "prettier": "^3.9.10"
  },
  "dependencies": {
    "@unocss/eslint-config": "^66.11.0",
    "@unocss/preset-wind3": "^66.11.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "prettier-plugin-slidev": "^1.0.5",
    "vue-eslint-parser": "^10.4.1"
  },
  "devDependencies": {
    "@comark/markdown-it": "^0.3.4",
    "@mdit-vue/plugin-component": "^3.0.2",
    "@release-it/conventional-changelog": "^12.0.2",
    "markdown-exit": "^1.3.0",
    "prettier": "^3.9.10",
    "release-it": "^21.1.1"
  }
}
